/* 充值页 */
.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 40rpx 28rpx 64rpx;
}

.hero { display: flex; flex-direction: column; margin-bottom: 28rpx; }
.eyebrow { color: #1d9e75; font-size: 22rpx; font-weight: 600; letter-spacing: 3rpx; }
.title { margin-top: 12rpx; font-size: 44rpx; font-weight: 700; line-height: 1.25; }
.subtitle { margin-top: 10rpx; color: #8a9099; font-size: 26rpx; }

.alert {
    box-sizing: border-box;
    margin-bottom: 20rpx;
    padding: 22rpx 24rpx;
    border-radius: 16rpx;
    font-size: 26rpx;
    line-height: 1.6;
}
.alert-ok { background: #e1f5ee; border: 2rpx solid #b8e0d0; color: #085041; }
.alert-err { background: #fdeee6; border: 2rpx solid #f5c9b3; color: #a5372a; }

.card {
    box-sizing: border-box;
    margin-bottom: 24rpx;
    padding: 28rpx;
    border-radius: 20rpx;
    background: #ffffff;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-title {
    display: block;
    margin-bottom: 20rpx;
    font-size: 30rpx;
    font-weight: 600;
}

.field-label {
    display: block;
    margin-bottom: 12rpx;
    color: #5f5e5a;
    font-size: 26rpx;
}
.required { color: #d85a30; }
.field-input {
    box-sizing: border-box;
    width: 100%;
    height: 88rpx;
    padding: 0 24rpx;
    border: 2rpx solid #dfe1e5;
    border-radius: 16rpx;
    font-size: 30rpx;
}

/* 余额卡 */
.balance-card {
    box-sizing: border-box;
    margin-bottom: 24rpx;
    padding: 32rpx;
    border-radius: 20rpx;
    background: linear-gradient(135deg, #378add, #185fa5);
    color: #ffffff;
}
.balance-label { font-size: 24rpx; opacity: 0.85; }
.balance-num { display: block; margin-top: 6rpx; font-size: 56rpx; font-weight: 600; line-height: 1.25; }
.balance-unit { font-size: 28rpx; font-weight: 400; }
.balance-meta { display: block; margin-top: 6rpx; font-size: 24rpx; opacity: 0.85; }

/* 套餐卡片 */
.plan-grid { display: flex; }
.plan {
    box-sizing: border-box;
    flex: 1;
    margin-right: 16rpx;
    padding: 24rpx 20rpx;
    border: 4rpx solid #dfe1e5;
    border-radius: 20rpx;
    background: #ffffff;
}
.plan:last-child { margin-right: 0; }
.plan.has-choice { border-color: #378add; background: #f5faff; }
.plan-name { display: block; font-size: 30rpx; font-weight: 600; }
.plan-desc { display: block; margin-top: 4rpx; color: #8a9099; font-size: 22rpx; }
.plan-price { display: block; margin-top: 12rpx; color: #ba7517; font-size: 30rpx; font-weight: 600; }

/* 时长档位 */
.period-list { display: flex; flex-direction: column; }
.period {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14rpx;
    padding: 24rpx 26rpx;
    border: 4rpx solid #dfe1e5;
    border-radius: 16rpx;
    background: #ffffff;
}
.period:last-child { margin-bottom: 0; }
.period.has-choice { border-color: #378add; background: #f5faff; }
.period-label { font-size: 28rpx; }
.period-price { color: #ba7517; font-size: 30rpx; font-weight: 600; }

/* 确认区 */
.confirm-row { display: flex; align-items: center; justify-content: space-between; }
.confirm-label { color: #5f5e5a; font-size: 28rpx; }
.confirm-price { color: #ba7517; font-size: 44rpx; font-weight: 700; }
.confirm-sub {
    display: block;
    margin-top: 8rpx;
    color: #8a9099;
    font-size: 24rpx;
    line-height: 1.6;
}

.primary-button,
.ghost-button {
    box-sizing: border-box;
    margin: 0 8rpx;
    padding: 0 24rpx;
    border-radius: 16rpx;
    font-size: 30rpx;
    line-height: 88rpx;
}
.primary-button { background: #378add; color: #ffffff; }
.ghost-button { border: 2rpx solid #dfe1e5; background: #ffffff; color: #1f2329; }
.full { width: 100%; margin: 24rpx 0 0; }
.back-row { margin-top: 8rpx; }

/* 价格表 */
.price-table { border: 2rpx solid #f0f1f2; border-radius: 12rpx; overflow: hidden; }
.price-row { display: flex; border-bottom: 2rpx solid #f4f5f6; }
.price-row:last-child { border-bottom: none; }
.price-head { background: #f7f8fa; }
.price-cell {
    flex: 1;
    padding: 16rpx 10rpx;
    color: #5f5e5a;
    font-size: 22rpx;
    text-align: left;
    white-space: nowrap;
}
.price-head .price-cell { color: #8a9099; }
